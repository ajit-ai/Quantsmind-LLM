# Example TAKSH engineering service deployment configuration.
# Copy to taksh-deployment.env and fill in real values. Never commit secrets.

TAKSH_ENGINEERING_TOKEN=replace-with-strong-random-token
TAKSH_TOKEN_SCOPES=read,execute
TAKSH_BIND_HOST=127.0.0.1
TAKSH_BIND_PORT=8000
TAKSH_MEMORY_PATH=.taksh/memory.json
TAKSH_LOG_LEVEL=info
